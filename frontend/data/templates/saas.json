          "sources": ["competitor websites", "product blogs", "comparisons"]
        },
        {
          "dimension": "customer-satisfaction",
          "description": "Satisfaction levels and churn drivers",
          "keywords": ["satisfied", "disappointed", "switching", "churn", "complaints"],
          "sources": ["g2 reviews", "reddit", "trustpilot"]
        },
        {
          "dimension": "market-positioning",
          "description": "How category is positioning in marketing",
          "keywords": ["positioning", "messaging", "target market", "value prop"],
          "sources": ["blogs", "ads", "case studies"]
        }
      ],
      "estimatedTime": 25
