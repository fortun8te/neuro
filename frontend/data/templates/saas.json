{
  "id": "saas",
  "name": "SaaS Research",
  "description": "Deep analysis of enterprise adoption, pricing strategy, competitive landscape, and integration ecosystem",
  "category": "saas",
  "icon": "🚀",
  "targetAudience": "SaaS companies launching new features or entering new markets",
  "bestFor": "Positioning announcements, feature releases, market expansion campaigns",
  "suggestedPreset": "NR",
  "estimatedTotalTime": 90,
  "exampleBrands": ["Figma", "Slack", "Notion", "Stripe", "HubSpot"],
  "keywords": ["saas", "enterprise", "b2b", "software", "integration", "pricing"],
  "sections": [
    {
      "sectionId": "enterprise-adoption",
      "title": "Enterprise Adoption Landscape",
      "description": "How enterprises evaluate and adopt SaaS solutions",
      "initialQueries": [
        "how enterprises evaluate SaaS tools 2025",
        "enterprise software decision criteria procurement",
        "SaaS adoption barriers enterprise buyers"
      ],
      "focusAreas": [
        {
          "dimension": "evaluation-criteria",
          "description": "What criteria enterprises use to evaluate software",
          "keywords": ["security", "compliance", "sso", "integration", "support", "roi"],
          "sources": ["blogs", "reviews", "whitepapers"]
        },
        {
          "dimension": "buying-committee",
          "description": "Who influences purchase decisions in enterprises",
          "keywords": ["cto", "cfo", "procurement", "security team", "decision maker"],
          "sources": ["blogs", "case studies", "reddit"]
        },
        {
          "dimension": "implementation-concerns",
          "description": "Biggest worries during implementation",
          "keywords": ["migration", "training", "integration", "downtime", "cost"],
          "sources": ["reddit", "reviews", "forums"]
        }
      ],
      "estimatedTime": 25
    },
    {
      "sectionId": "pricing-strategy",
      "title": "Pricing Strategy & Models",
      "description": "How competitors price and what resonates with enterprises",
      "initialQueries": [
        "SaaS pricing strategy per-user vs value-based 2025",
        "competitive pricing benchmarks software tools",
        "enterprise SaaS pricing objections negotiation"
      ],
      "focusAreas": [
        {
          "dimension": "pricing-models",
          "description": "Per-seat, value-based, freemium, usage-based",
          "keywords": ["per-user", "consumption", "freemium", "value-based", "flat-fee"],
          "sources": ["competitor websites", "blogs", "pricing pages"]
        },
        {
          "dimension": "discount-patterns",
          "description": "What discount levels and contract lengths are common",
          "keywords": ["annual discount", "multi-year", "volume pricing", "negotiation"],
          "sources": ["sales conversations", "reddit", "g2 reviews"]
        },
        {
          "dimension": "pricing-objections",
          "description": "Common objections and how to overcome them",
          "keywords": ["too expensive", "roi calculation", "budget approval", "vat"],
          "sources": ["reddit", "reviews", "sales blogs"]
        }
      ],
      "estimatedTime": 20
    },
    {
      "sectionId": "competitive-positioning",
      "title": "Competitive Landscape & Gaps",
      "description": "How competitors position, where differentiation opportunities exist",
      "initialQueries": [
